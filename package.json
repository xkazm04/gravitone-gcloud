{
  "name": "gravitone-gcloud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test:unit": "vitest run",
    "test:unit-mutants": "node pipeline/unit-mutants.mts",
    "style-contract": "node pipeline/style-contract.mts",
    "worker": "node workers/runner.mts",
    "worker:gpu": "python pipeline/foundry/worker.py",
    "typecheck:next": "tsc -b packages/catalog packages/domain packages/kernel packages/producers packages/ui",
    "next-structure": "node pipeline/next-gates.mts",
    "tokens:gen": "node pipeline/gen-tokens.mts",
    "tokens:check": "node pipeline/check-tokens.mts",
    "dev": "next dev",
    "fixtures": "npx tsx pipeline/fixtures/generate.mts",
    "dev:fixtures": "node pipeline/dev-guard.mjs NEXT_PUBLIC_GRAVITONE_DATA=fixtures NEXT_PUBLIC_DEV_AUTH=1 NEXT_DIST_DIR=.next-fixtures next dev -p 3100",
    "dev:inspect": "node pipeline/dev-guard.mjs DEV_INSPECT=1 DEV_GUARD_MAX_NODE=150 NEXT_DIST_DIR=.next-inspect next dev",
    "dev:inspect:webpack": "node pipeline/dev-guard.mjs DEV_INSPECT=1 DEV_INSPECT_BUNDLER=webpack DEV_GUARD_MAX_NODE=150 NEXT_DIST_DIR=.next-inspect next dev --webpack",
    "build": "next build",
    "start": "next start",
    "scan:probe-gaps": "node pipeline/probe-gap-scan.mjs",
    "check:notebook": "npx tsx pipeline/check-notebook.mts",
    "check:manifest": "node pipeline/check-manifest.mjs",
    "copy:check": "node .claude/skills/native-copy/scripts/copy-check.mjs",
    "check:bundle": "node pipeline/check-bundle.mjs",
    "suno:browser": "node pipeline/suno-browser.mjs",
    "medium:browser": "node pipeline/medium-browser.mjs",
    "dojo:status": "npx tsx pipeline/dojo-status.mts",
    "suno:import": "npx tsx pipeline/suno-import.mts",
    "verify:text": "npx tsx pipeline/verify-text-engine.mts",
    "check:trailer-structure": "npx tsx pipeline/trailer-structure-regression.mts",
    "check:gate": "npx tsx pipeline/gate-regression.mts",
    "preflight": "npx tsx pipeline/preflight.mts",
    "test:mutants": "npx tsx pipeline/probe-mutants.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ratchet": "node pipeline/lint-ratchet.mjs",
    "test": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "verify": "node pipeline/run-gates.mts",
    "verify:serial": "npm run typecheck && npm run lint:ratchet && npm run check:manifest && npm run check:notebook && npm run check:type && npm run check:narration && npm run check:clips && npm run check:trailer-structure && npm run check:gate && npm run check:frames-prompt && npm run check:ads-prompts && npm run check:scout-scene && npm run check:voice-fx && npm run check:style-refs && npm run check:vocab && npm run next-structure && npm run typecheck:next && npm run test:unit && npm run tokens:check && npm test && npm run build && npm run check:bundle",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "check:type": "node pipeline/check-type-scale.mjs",
    "check:frames-prompt": "npx tsx pipeline/frames-prompt-regression.mts",
    "check:ads-prompts": "npx tsx pipeline/ads-prompts-regression.mts",
    "check:scout-scene": "npx tsx pipeline/scout-scene-regression.mts",
    "check:voice-fx": "npx tsx pipeline/voice-fx-regression.mts",
    "check:score": "npx tsx pipeline/score-regression.mts",
    "check:audio-triage": "npx tsx pipeline/audio-triage-eval.mts --gate",
    "check:style-refs": "npx tsx pipeline/style-ref-stability.mts",
    "check:narration": "node pipeline/check-narration.mjs",
    "check:clips": "node pipeline/check-clips.mjs",
    "check:vocab": "node pipeline/check-vocab.mjs",
    "build:preset-clips": "npx tsx pipeline/build-preset-clips.mts"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
