# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the template IS the opt-in. It holds no secrets — only the variable
# names and what each is for — and an example file that is not in the repo
# cannot onboard anybody, which is exactly what had happened to it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skill memory: the in-repo vault the adopted skills write to (/perfect, /explorer,
# /research, /uat, /ship-loop). Obsidian-openable, deliberately not versioned —
# it is session memory, not source.
/.vault/

# UAT capture artifacts (screenshots); the reports themselves ARE committed
uat/runs/*/captures/

# skill-local scratch: generated art + traces, and motionize's own deps
.claude/skills/leonardo/out/
.claude/skills/motionize/out/
.claude/skills/motionize/node_modules/

# /research working cache (craft-mode corpora live in knowledge/, not here)
.research-cache/
.next-drive/
# A builder or a UAT run starts `next dev -p 31xx` on its own port, and Next
# writes .next-<port>/ beside it and appends that dir to tsconfig's `include`.
# Both are per-session artifacts. Ignore the dirs; revert the tsconfig edit.
.next-*/

# Driven UI captures. Regenerable from the drive suites; heavy in git.
pipeline/runs/*/captures/

# Integration-probe output (pipeline/integration-imaging.mts) — real generated
# images, written for a human to look at. Never versioned.
/imaging-probe-out/

# Trial plates (pipeline/build-style-trials.mts) — regenerable experiment
# artifacts, and they will be deleted outright once Step 3 is settled. The
# JUDGEMENTS in public/trials/index.json stay versioned: that file is the
# finding, the JPEGs are only the evidence behind it.
# (public/presets/*.jpg are NOT here — those are product assets the rail
# renders at runtime, not experiment output.)
/public/trials/**/*.jpg

# Art-direction output (pipeline/direct-frames.mts) — scene specs plus the
# authored/template comparison plates. Regenerable, and deleted once Step 3
# settles; the finding lives in the commit message and docs.
/frames-direction-out/

# Playwright golden-path probe artifacts
/test-results/

# VLM frame-annotation probe (pipeline/vlm-probe). Two kinds of unversionable:
# the frames are third-party film content held locally for evaluation only, and
# the result rows are regenerable evidence. The FINDING gets committed — to the
# ai-registry, as knowledge — not the rows behind it.
/vlm-probe-out/
/pipeline/vlm-probe/media/
/pipeline/vlm-probe/replicas/
/pipeline/vlm-probe/gallery/
/pipeline/vlm-probe/.ingest/
__pycache__/
*.pyc
/pipeline/vlm-probe/frames/*
!/pipeline/vlm-probe/frames/truth/
!/pipeline/vlm-probe/frames/truth/*.json

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-registry.mjs)
# Links are machine state; the declarations live in .ai/manifest.yaml (`skills:` and `knowledge.domains`).
/.claude/skills/architect
/.claude/skills/conform
/.claude/skills/consult
/.claude/skills/explorer
/.claude/skills/leonardo
/.claude/skills/perfect
/.claude/skills/research
/.claude/skills/scan-sweep
/.claude/skills/ship-loop
/.claude/skills/tiger
/.claude/skills/uat
/.claude/skills/dojo
/.claude/skills/motionize
/.claude/skills/spark
/.claude/rules/ai-registry-access.md
/.claude/rules/ai-registry-software-engineering.md
/.claude/rules/ai-registry-media-generation.md
# END ai-registry linked skills

# Foundry runs (pipeline/foundry/forge.py) — generated candidates, their
# sidecars and the cropped third-party reference frames. Regenerable from a
# plan file. The verdicts and the style catalogue ARE versioned
# (pipeline/foundry/{ledger,styles}.json): those are the finding.
/foundry-out/

# forge logs (pipeline/foundry/forge.py > logs/)
/pipeline/foundry/logs/

# vlm-probe generated plates and clips. The spike's stills and video are
# regenerable output, not source: every lane keeps its lane.json (seed, the
# verbatim character/location clauses, steps, and where the reference joins),
# which is what makes the run reproducible. The pixels are ~43 MB and grow per
# lane; CONSISTENCY-FINDINGS.md carries the numbers and the read.
/pipeline/vlm-probe/shots/**/*.png
/pipeline/vlm-probe/shots/**/*.jpg
/pipeline/vlm-probe/clips/**/*.png
/pipeline/vlm-probe/clips/**/*.jpg
/pipeline/vlm-probe/clips/**/*.mp4
