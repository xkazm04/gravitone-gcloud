# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skill memory: the in-repo vault the adopted skills write to (/perfect, /explorer,
# /research, /uat, /ship-loop). Obsidian-openable, deliberately not versioned —
# it is session memory, not source.
/.vault/

# UAT capture artifacts (screenshots); the reports themselves ARE committed
uat/runs/*/captures/

# skill-local scratch: generated art + traces, and motionize's own deps
.claude/skills/leonardo/out/
.claude/skills/motionize/out/
.claude/skills/motionize/node_modules/

# /research working cache (craft-mode corpora live in knowledge/, not here)
.research-cache/
.next-drive/

# Driven UI captures. Regenerable from the drive suites; heavy in git.
pipeline/runs/*/captures/
