{
  "page": {
    "winner": "app/library.html",
    "port": "/kit"
  },
  "roles": {
    "ground": {
      "winner": "body",
      "port": "[data-world=next]"
    },
    "header": {
      "winner": "[data-component=StudioHeader]",
      "port": "[data-component=StudioHeader]"
    },
    "brand": {
      "winner": ".brand",
      "port": "[data-component=StudioHeader] > span:first-child"
    },
    "nav-rest": {
      "winner": ".nav a[data-nav=ledger]",
      "port": "[data-role=\"nav-rest@ledger\"]"
    },
    "nav-current": {
      "winner": ".nav [aria-current=page]",
      "port": "[data-role=\"nav-current@library\"]"
    },
    "chip": {
      "winner": ".hdr-spend",
      "port": "[data-role=\"chip\"] > *"
    },
    "chip-value": {
      "winner": ".hdr-spend b",
      "port": "[data-role=\"chip\"] b"
    },
    "tally": {
      "winner": ".next-btn .tally",
      "port": "[data-role=\"tally\"] > *"
    },
    "keycap": {
      "winner": ".next-btn .keycap",
      "port": "[data-role=\"keycap\"] > *"
    },
    "panel": {
      "winner": ".panel.lnav",
      "port": "[data-role=\"panel@library\"] > *"
    },
    "panel-head": {
      "winner": ".lnav .panel-head",
      "port": "[data-role=\"panel@library\"] h2"
    },
    "field": {
      "winner": ".lsearch .field",
      "port": "[data-role=\"search@library\"] input"
    },
    "facet-check": {
      "winner": ".frow",
      "port": "[data-role=\"facet-check\"] > *"
    },
    "body-text": {
      "winner": ".frow .fl",
      "port": "[data-role=\"facet-check\"] > * > span:nth-of-type(2)"
    },
    "hint": {
      "winner": ".hint > button",
      "port": "[data-role=\"hint\"] button"
    },
    "status-ref": {
      "winner": ".state.reference",
      "port": "[data-role=\"status-ref\"] > *"
    },
    "status-cand": {
      "winner": ".state.candidate",
      "port": "[data-role=\"status-cand\"] > *"
    },
    "status-done": {
      "winner": ".state.ratified",
      "port": "[data-role=\"status-done@library\"] > *"
    },
    "tally-label": {
      "winner": ".lhead .tally",
      "port": "[data-role=\"tally-label@library\"] > *"
    }
  }
}
