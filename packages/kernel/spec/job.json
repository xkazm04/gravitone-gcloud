        { "t": 2, "by": "py", "op": "book", "as": "P", "job": "g1", "step": "s1", "expect": "ok" },
        { "t": 3, "by": "py", "op": "start", "as": "P", "job": "g1", "step": "s2", "expect": "ok" },
        { "t": 4, "by": "node", "op": "kill", "as": "P", "expect": "ok" },
        { "t": 5, "by": "node", "op": "recover", "as": "N", "expect": ["g1"] },
        { "t": 5, "by": "node", "op": "state", "job": "g1", "expect": { "state": "interrupted", "attempt": 1, "outputs": ["s1"], "stage": "s2" } },
        { "t": 6, "by": "node", "op": "retry", "job": "g1", "expect": "queued" },
        { "t": 7, "by": "node", "op": "drive", "as": "N", "job": "g1", "steps": ["s1", "s2"], "expect": { "blocked": "s2" } },
        { "t": 8, "by": "node", "op": "perform", "job": "g1", "expect": { "outcome": "done" } },
        { "t": 8, "by": "node", "op": "state", "job": "g1", "expect": { "state": "done", "attempt": 2, "outputs": ["s1", "s2"] } },
        { "t": 8, "by": "node", "op": "verify", "expect": "intact" }
      ]
