        { "t": 6, "by": "py", "op": "claim", "as": "P", "job": "q2", "expect": "granted" },
        { "t": 7, "by": "py", "op": "finish", "as": "P", "job": "q2", "expect": "ok" },
        { "t": 7, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "a planned job waits for its release in both languages",
      "jobs": { "p1": { "lane": "gpu.local", "producer": "forge", "state": "planned" } },
      "steps": [
        { "t": 0, "by": "py", "op": "claim", "as": "P", "job": "p1", "expect": { "notQueued": "planned" } },
        { "t": 1, "by": "node", "op": "drive", "as": "N", "job": "p1", "steps": ["a"], "expect": { "outcome": "not-queued" } },
        { "t": 2, "by": "node", "op": "release", "job": "p1", "expect": "queued" },
        { "t": 3, "by": "py", "op": "claim", "as": "P", "job": "p1", "expect": "granted" },
