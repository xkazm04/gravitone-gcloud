        { "t": 105, "by": "py", "op": "finish", "as": "Q", "job": "q2", "expect": "ok" },
        { "t": 105, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "Python's take-over of a dead Node holder on a paid lane holds the lane, as Node's own would",
      "jobs": { "q1": { "lane": "cloud.qwen", "producer": "extract" }, "q2": { "lane": "cloud.qwen", "producer": "extract" } },
      "steps": [
        { "t": 0, "by": "node", "op": "drive", "as": "N", "job": "q1", "steps": ["a"], "expect": { "blocked": "a" } },
        { "t": 1, "by": "py", "op": "kill", "as": "N", "expect": "ok" },
