        { "t": 2, "by": "node", "op": "state", "job": "g1", "expect": { "state": "failed", "attempt": 1, "outputs": [], "error": "invalid" } },
        { "t": 3, "by": "py", "op": "claim", "as": "P", "job": "g2", "expect": "granted" },
        { "t": 4, "by": "py", "op": "start", "as": "P", "job": "g2", "step": "s1", "expect": "ok" },
        { "t": 5, "by": "py", "op": "failStep", "as": "P", "job": "g2", "step": "s1", "message": "comfyui refused the prompt", "expect": "ok" },
        { "t": 6, "by": "py", "op": "start", "as": "P", "job": "g2", "step": "s1", "expect": "ok" },
        { "t": 7, "by": "py", "op": "failStep", "as": "P", "job": "g2", "step": "s1", "message": "comfyui refused the prompt", "expect": "ok" },
        { "t": 8, "by": "py", "op": "start", "as": "P", "job": "g2", "step": "s1", "expect": "ok" },
        { "t": 9, "by": "py", "op": "failStep", "as": "P", "job": "g2", "step": "s1", "message": "comfyui refused the prompt", "expect": "ok" },
        { "t": 9, "by": "node", "op": "state", "job": "g2", "expect": { "state": "failed", "attempt": 1, "outputs": [], "error": "unavailable" } },
