{
  "about": "The job protocol across two languages, as a table. Run by packages/kernel/test/job.python.test.ts: each scenario's jobs are enqueued by Node (in order, dry unless `mode` says live, queued unless `state` says planned), then its steps run in order on ONE store file - a `by: node` step through the Node kernel (runJob with a producer the step drives, the operator's acts, recover, loadJob), a `by: py` step through packages/kernel/py/job.py (py/job_spec.py serves them). Times are seconds after `base` on both clocks. Outcomes - py claim: granted | busy | {notQueued: state} | {held: jobId} | {refused: true}; py start/book/fail/failStep/finish/park/heartbeat: ok | conflict | {stopped: state} | {refused: true}; node drive/perform: {blocked: step} while a step is in flight, else {outcome} as runJob reported it, or {error: code}; node state: the record as Node's door reads it (state, attempt, outputs by step, stage, slot, error code) after checking its spend reconciles to the meter; kill marks an actor's pid dead on both sides; verify: both chain verifiers.",
  "base": "2026-10-16T00:00:00.000Z",
  "ttlS": 60,
  "actors": {
    "N": { "bootId": "boot-n", "pid": 101, "host": "h1" },
    "P": { "bootId": "boot-p", "pid": 102, "host": "h1" },
    "Q": { "bootId": "boot-q", "pid": 103, "host": "h1" }
  },
  "scenarios": [
    {
      "name": "Python drives a job end to end, and Node's door reads every record it wrote",
      "jobs": { "g1": { "lane": "gpu.local", "producer": "forge" } },
      "steps": [
        { "t": 0, "by": "py", "op": "claim", "as": "P", "job": "g1", "expect": "granted" },
        { "t": 0, "by": "node", "op": "state", "job": "g1", "expect": { "state": "running", "attempt": 1, "outputs": [], "slot": "gpu.local#1" } },
        { "t": 1, "by": "py", "op": "start", "as": "P", "job": "g1", "step": "annotate", "expect": "ok" },
        { "t": 1, "by": "node", "op": "state", "job": "g1", "expect": { "state": "running", "attempt": 1, "outputs": [], "slot": "gpu.local#1", "stage": "annotate" } },
        { "t": 2, "by": "py", "op": "book", "as": "P", "job": "g1", "step": "annotate", "expect": "ok" },
        { "t": 3, "by": "py", "op": "start", "as": "P", "job": "g1", "step": "generate", "expect": "ok" },
        { "t": 4, "by": "py", "op": "book", "as": "P", "job": "g1", "step": "generate", "expect": "ok" },
        { "t": 5, "by": "py", "op": "finish", "as": "P", "job": "g1", "expect": "ok" },
        { "t": 5, "by": "node", "op": "state", "job": "g1", "expect": { "state": "done", "attempt": 1, "outputs": ["annotate", "generate"] } },
        { "t": 5, "by": "node", "op": "events", "job": "g1", "expect": ["job.enqueued", "job.claimed", "job.step-started", "job.step-done", "job.step-started", "job.step-done", "job.done"] },
        { "t": 5, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "Node and Python cannot hold the same slot: gpu.local has one, and either holder makes the other busy",
      "jobs": { "g1": { "lane": "gpu.local", "producer": "forge" }, "g2": { "lane": "gpu.local", "producer": "dojo" }, "g3": { "lane": "gpu.local", "producer": "forge" } },
      "steps": [
        { "t": 0, "by": "node", "op": "drive", "as": "N", "job": "g1", "steps": ["a"], "expect": { "blocked": "a" } },
        { "t": 1, "by": "py", "op": "claim", "as": "P", "job": "g2", "expect": "busy" },
        { "t": 2, "by": "node", "op": "perform", "job": "g1", "expect": { "outcome": "done" } },
        { "t": 3, "by": "py", "op": "claim", "as": "P", "job": "g2", "expect": "granted" },
        { "t": 4, "by": "node", "op": "drive", "as": "N", "job": "g3", "steps": ["a"], "expect": { "outcome": "busy" } },
        { "t": 5, "by": "py", "op": "finish", "as": "P", "job": "g2", "expect": "ok" },
        { "t": 6, "by": "node", "op": "drive", "as": "N", "job": "g3", "steps": ["a"], "expect": { "blocked": "a" } },
        { "t": 7, "by": "node", "op": "perform", "job": "g3", "expect": { "outcome": "done" } },
        { "t": 7, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "a lane with four slots: Python takes the next one Node left free",
      "jobs": { "t1": { "lane": "seat.text", "producer": "article" }, "t2": { "lane": "seat.text", "producer": "article" } },
      "steps": [
        { "t": 0, "by": "node", "op": "drive", "as": "N", "job": "t1", "steps": ["a"], "expect": { "blocked": "a" } },
        { "t": 1, "by": "py", "op": "claim", "as": "P", "job": "t2", "expect": "granted" },
        { "t": 1, "by": "node", "op": "state", "job": "t2", "expect": { "state": "running", "attempt": 1, "outputs": [], "slot": "seat.text#2" } },
        { "t": 2, "by": "py", "op": "start", "as": "P", "job": "t2", "step": "a", "expect": "ok" },
        { "t": 3, "by": "py", "op": "book", "as": "P", "job": "t2", "step": "a", "expect": "ok" },
        { "t": 4, "by": "py", "op": "finish", "as": "P", "job": "t2", "expect": "ok" },
        { "t": 5, "by": "node", "op": "perform", "job": "t1", "expect": { "outcome": "done" } },
        { "t": 5, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "a Python zombie's late book is refused by the fence; Node's take-over named its job interrupted",
