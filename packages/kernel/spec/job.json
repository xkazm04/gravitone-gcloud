    {
      "name": "a live job is refused before anything is claimed in a dry-only process, in both languages",
      "jobs": { "l1": { "lane": "gpu.local", "producer": "forge", "mode": "live" } },
      "steps": [
        { "t": 0, "by": "py", "op": "claim", "as": "P", "job": "l1", "dryOnly": true, "expect": { "refused": true } },
        { "t": 1, "by": "node", "op": "drive", "as": "N", "job": "l1", "steps": ["a"], "dryOnly": true, "expect": { "error": "refused" } },
