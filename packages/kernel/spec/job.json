        { "t": 101, "by": "node", "op": "state", "job": "g1", "expect": { "state": "interrupted", "attempt": 1, "outputs": [], "stage": "a" } },
        { "t": 102, "by": "py", "op": "finish", "as": "P", "job": "g2", "expect": "ok" },
        { "t": 102, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "a crash on a paid lane holds it for Node and Python alike until an operator acknowledges",
      "jobs": { "q1": { "lane": "cloud.qwen", "producer": "extract" }, "q2": { "lane": "cloud.qwen", "producer": "extract" }, "q3": { "lane": "cloud.qwen", "producer": "extract" } },
      "steps": [
        { "t": 0, "by": "py", "op": "claim", "as": "P", "job": "q1", "expect": "granted" },
