        { "t": 100, "by": "node", "op": "drive", "as": "N", "job": "g2", "steps": ["a"], "expect": { "blocked": "a" } },
        { "t": 100, "by": "node", "op": "state", "job": "g1", "expect": { "state": "interrupted", "attempt": 1, "outputs": [], "stage": "generate" } },
        { "t": 101, "by": "py", "op": "book", "as": "P", "job": "g1", "step": "generate", "expect": "conflict" },
        { "t": 101, "by": "py", "op": "heartbeat", "as": "P", "job": "g1", "expect": "conflict" },
        { "t": 101, "by": "node", "op": "state", "job": "g1", "expect": { "state": "interrupted", "attempt": 1, "outputs": [], "stage": "generate" } },
        { "t": 102, "by": "node", "op": "perform", "job": "g2", "expect": { "outcome": "done" } },
        { "t": 102, "by": "node", "op": "verify", "expect": "intact" }
      ]
    },
    {
      "name": "a Node zombie's late book is refused by the fence when Python takes the slot",
      "jobs": { "g1": { "lane": "gpu.local", "producer": "forge" }, "g2": { "lane": "gpu.local", "producer": "dojo" } },
      "steps": [
        { "t": 0, "by": "node", "op": "drive", "as": "N", "job": "g1", "steps": ["a"], "expect": { "blocked": "a" } },
