# Firebase web config — the studio's only credential.
#
# Copy to .env.local and fill in from Firebase console → Project settings → Web
# app. These three are all the client needs: Google sign-in (auth) and nothing
# else. The API key is PUBLIC by design (it ships in the browser bundle);
# access is secured by Firebase Auth's authorized-domain list, not by secrecy.
#
# UNSET is a supported posture, not a broken one. With no project id,
# lib/firebase.ts reports firebaseReady = false, the landing page says auth is
# off, and every gated route fails CLOSED (bounce to /) rather than rendering
# the studio to everyone. Projects still live in the browser's IndexedDB — see
# lib/studioDb.ts — so a self-hosted single-user run needs no Firebase at all
# once you drop the gate.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Imaging vendors (lib/imaging) ───────────────────────────────────────────
#
# UNLIKE the Firebase block above, these are SECRETS. None is prefixed
# NEXT_PUBLIC_, and none may ever be: they are read only inside route handlers
# under app/api/imaging/*, and each one bills a real balance. See docs/imaging.md.
#
# Which vendor answers is decided by IMAGING_ENV. A caller may steer within
# that table (`prefer`/`avoid` on any /api/imaging request — `avoid` is the move
# after a safety refusal), but it can never name a vendor this table does not
# plan for the capability:
#   dev   Google generates and edits · Qwen recognises · Leonardo is the
#         re-route target for generate, reached only if Google refuses
#   prod  Google does all three
# Unset it and the app follows NODE_ENV — dev locally, prod in a production build.
IMAGING_ENV=

# Leonardo — app.leonardo.ai/api-access. The dev re-route target for generation
# (Lucid Origin), not the dev default: it reads no style references, so a
# style-locked request never lands here.
# Note: every generation this app makes is DELETED after the image is
# downloaded, so the account's gallery stays clean. See lib/imaging/providers/leonardo.ts.
LEONARDO_API_KEY=

# Qwen / DashScope — recognition in dev (qwen3.8-max). International endpoint by
# default; set QWEN_BASE_URL to the Beijing host if the account lives there.
QWEN_API_KEY=
QWEN_BASE_URL=

# Google AI Studio — all three capabilities in production, and generate+edit in
# dev as well. Without this key, dev generation falls back to Leonardo and
# style-locked generation cannot run at all.
# Nano Banana 2 for generate/edit (NOT Lite — Lite has no style references),
# Gemini 3.6 Flash for recognition. GOOGLE_IMAGE_SIZE is 0.5K/1K/2K/4K.
# Both model ids are overridable below, for when the next one ships.
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_MODEL=
GOOGLE_VISION_MODEL=
GOOGLE_IMAGE_SIZE=

# ── Route access gate (lib/apiAuth.ts) ──────────────────────────────────────
#
# The money/compute routes — app/api/imaging/{generate,edit,recognize} and
# app/api/frames — are access-gated. They FAIL CLOSED: with IMAGING_ACCESS_SECRET
# unset, every one of them answers 401. Set it to any hard-to-guess string and
# present it as `Authorization: Bearer <secret>` (or `x-imaging-access-secret`).
#
# firebase-admin is not a dependency here, so this is a shared secret rather than
# a Firebase ID-token check. A browser can only present a secret that shipped in
# its bundle, so the client copy below is PUBLIC — this bounds casual abuse and
# rate, not a determined attacker. Wire firebase-admin to upgrade to real
# per-user identity; the server already accepts a Bearer token.
IMAGING_ACCESS_SECRET=
# The browser's copy of the same value (inlined into the bundle, hence public).
# Set it equal to IMAGING_ACCESS_SECRET so the studio's own UI can call the routes.
NEXT_PUBLIC_IMAGING_ACCESS_SECRET=
# In-memory per-IP token bucket. Defaults: 30 requests / 60s.
IMAGING_RATE_CAPACITY=
IMAGING_RATE_WINDOW_SEC=

# ── Spend ceiling (lib/imaging/budget.ts) ───────────────────────────────────
#
# The chokepoint (lib/imaging/router.ts) refuses a call that would push spend in
# a rolling window past this ceiling — priced with the pre-call estimate. Default
# is 5 USD per 1-hour window; a call over it throws `over-budget` (HTTP 402).
IMAGING_BUDGET_USD_PER_WINDOW=
IMAGING_BUDGET_WINDOW_MS=
