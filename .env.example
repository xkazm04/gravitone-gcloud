# Firebase web config — the studio's only credential.
#
# Copy to .env.local and fill in from Firebase console → Project settings → Web
# app. These three are all the client needs: Google sign-in (auth) and nothing
# else. The API key is PUBLIC by design (it ships in the browser bundle);
# access is secured by Firebase Auth's authorized-domain list, not by secrecy.
#
# UNSET is a supported posture, not a broken one. With no project id,
# lib/firebase.ts reports firebaseReady = false, the landing page says auth is
# off, and every gated route fails CLOSED (bounce to /) rather than rendering
# the studio to everyone. Projects still live in the browser's IndexedDB — see
# lib/studioDb.ts — so a self-hosted single-user run needs no Firebase at all
# once you drop the gate.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Imaging vendors (lib/imaging) ───────────────────────────────────────────
#
# UNLIKE the Firebase block above, these are SECRETS. None is prefixed
# NEXT_PUBLIC_, and none may ever be: they are read only inside route handlers
# under app/api/imaging/*, and each one bills a real balance. See docs/imaging.md.
#
# Which vendor answers is decided by IMAGING_ENV, not by the caller:
#   dev   Leonardo generates · Qwen recognises · Google edits
#   prod  Google does all three
# Unset it and the app follows NODE_ENV — dev locally, prod in a production build.
IMAGING_ENV=

# Leonardo — app.leonardo.ai/api-access. Generation in dev (Lucid Origin).
# Note: every generation this app makes is DELETED after the image is
# downloaded, so the account's gallery stays clean. See lib/imaging/providers/leonardo.ts.
LEONARDO_API_KEY=

# Qwen / DashScope — recognition in dev (qwen3.8-max). International endpoint by
# default; set QWEN_BASE_URL to the Beijing host if the account lives there.
QWEN_API_KEY=
QWEN_BASE_URL=

# Google AI Studio — the production vendor for all three capabilities.
# Nano Banana 2 for generate/edit (NOT Lite — Lite has no style references),
# Gemini 3.6 Flash for recognition. GOOGLE_IMAGE_SIZE is 0.5K/1K/2K/4K.
# Both model ids are overridable below, for when the next one ships.
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_MODEL=
GOOGLE_VISION_MODEL=
GOOGLE_IMAGE_SIZE=
